{
  "name": "musegarden-electron",
  "version": "0.1.0",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "package": "electron-packager . MuseGarden --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite",
    "build": "electron-builder --win portable"
  },

  "build": {
    "appId": "com.musegarden.app",
    "productName": "MuseGarden",

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*"
    ],

    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  },

  "devDependencies": {
    "electron": "^26.6.10",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.0"
  }
}